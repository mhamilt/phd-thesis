  keywords     = {Algebras,Linear ; Differential equations,Partial ; Eigenvalues ; Mathematics ; Numerical analysis ; Physical sciences},
  number       = {1},
  pages        = {333--356},
  title        = {Sparse Matrices In Matlab - Design And Implementation},
