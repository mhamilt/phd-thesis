  date      = {2013-05},
  doi       = {10.5281/zenodo.1293003},
  issn      = {2220-4806},
  keywords  = {Haptics,force feedback,mapping,human-computer interaction},
  pages     = {369--372},
  title     = {Feeling for Sound: Mapping Sonic Data to Haptic Perceptions},
}

